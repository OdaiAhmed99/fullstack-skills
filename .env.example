# Copy to .env and change every "change-me". Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost
# The project's one language - pick it when you start the project (en, ar, ...)
DJANGO_LANGUAGE_CODE=en

# --- Postgres (host is the compose service name) ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery / Channels ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Email (console backend locally) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Frontend (Vite reads VITE_*) ---
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws

# --- Ports on your machine ---
NGINX_PORT=80
