# Copy to .env and change every "change-me". Never commit .env.
# Works as-is for the local run (run.ps1): SQLite, no Redis, no Docker.
# Docker (run-docker.ps1) sets POSTGRES_HOST and REDIS_URL itself in docker-compose.yml.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
# The project's one language - pick it when you start the project (en, ar, ...)
DJANGO_LANGUAGE_CODE=en

# --- Database ---
# Empty POSTGRES_HOST = SQLite file backend/db.sqlite3 (local). Docker sets POSTGRES_HOST=db.
POSTGRES_HOST=
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Redis (optional) ---
# Empty = in-memory cache, Celery tasks run inline. To use Redis locally see docs/setup-docker-redis.md:
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Email (printed to the console locally) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Frontend (Vite reads VITE_*) ---
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws

# --- Ports ---
NGINX_PORT=80
